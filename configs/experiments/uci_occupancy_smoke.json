{
  "dataset_id": "UCIOccupancyDetection",
  "training": {
    "window_size": 8,
    "stride": 1,
    "batch_size": 2,
    "epochs": 1,
    "learning_rate": 0.0001,
    "seed": 42,
    "max_steps": 2
  },
  "diffusion": {
    "timesteps": 4,
    "beta_0": 0.0001,
    "beta_T": 0.02
  },
  "architecture": {
    "backbone": "S4",
    "hdim": 64,
    "layers": 4,
    "num_res_layers": 1,
    "res_channels": 4,
    "skip_channels": 4,
    "diff_step_embed_in": 8,
    "diff_step_embed_mid": 8,
    "diff_step_embed_out": 8,
    "s4_lmax": 8,
    "s4_dstate": 8,
    "s4_dropout": 0.0,
    "s4_bidirectional": true,
    "s4_layernorm": true,
    "proportional_cyclic_encoding": false
  },
  "artifacts": {
    "checkpoint_path": "smoke_artifacts/uci_occupancy/experiment_config/model.pth",
    "output_dir": "smoke_artifacts/uci_occupancy/experiment_config/generated"
  },
  "synthesis": {
    "stride": 1,
    "profile": "C",
    "trials": 1,
    "batch_size": 2,
    "max_windows": 1
  }
}
